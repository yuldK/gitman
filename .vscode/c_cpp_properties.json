{
    "version": 4,
    "configurations": [
        {
            "name": "Windows-MSVC x64 (CMake VS2022)",
            "compilerPath": "cl.exe",
            "compilerArgs": [
                "/std:c++20"
            ],
            "intelliSenseMode": "windows-msvc-x64",
            "cppStandard": "c++20",
            "cStandard": "c17",
            "windowsSdkVersion": "10.0.22621.0",
            "defines": [
                "UNICODE",
                "_UNICODE",
                "NOMINMAX",
                "WIN32_LEAN_AND_MEAN"
            ],
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/vs2022/generated/include",
                "${workspaceFolder}/build/vs2022/vcpkg_installed/x64-windows-static/include"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/build/vs2022/generated/include",
                    "${workspaceFolder}/build/vs2022/vcpkg_installed/x64-windows-static/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        },
        {
            "name": "Windows-MSVC x64 (CMake VS2026)",
            "compilerPath": "cl.exe",
            "compilerArgs": [
                "/std:c++20"
            ],
            "intelliSenseMode": "windows-msvc-x64",
            "cppStandard": "c++20",
            "cStandard": "c17",
            "windowsSdkVersion": "10.0.22621.0",
            "defines": [
                "UNICODE",
                "_UNICODE",
                "NOMINMAX",
                "WIN32_LEAN_AND_MEAN"
            ],
            "includePath": [
                "${workspaceFolder}/src",
                "${workspaceFolder}/build/vs2026/generated/include",
                "${workspaceFolder}/build/vs2026/vcpkg_installed/x64-windows-static/include"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/build/vs2026/generated/include",
                    "${workspaceFolder}/build/vs2026/vcpkg_installed/x64-windows-static/include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
